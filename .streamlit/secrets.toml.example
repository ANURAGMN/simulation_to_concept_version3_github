# Streamlit Secrets Template
# Copy this file to secrets.toml and fill in your values
# For local development, you can also use .env file

# Google API Configuration
GOOGLE_API_KEY = "your-google-api-key-here"

# LLM Model Selection
GEMINI_MODEL = "gemini-2.0-flash"

# LLM Parameters
TEMPERATURE = "0.7"

# Teaching Agent Configuration
MAX_EXCHANGES = "6"
SCAFFOLD_TRIGGER = "3"
